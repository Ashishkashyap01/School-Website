<?xml version="1.0" encoding="utf-8"?>

<configuration>

<system.webServer>

<handlers>

<remove name="PHP_via_FastCGI"/>
   <!-- Disable folder listing -->
        <directoryBrowse enabled="false" />
<add
name="BlockPHP"
path="*.php"
verb="*"
modules="IsapiModule"
scriptProcessor=""
resourceType="File"
requireAccess="None"/>

</handlers>

</system.webServer>

</configuration>